{
	"name": "huedash",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "pnpm test:unit --run && pnpm test:e2e",
		"test:e2e": "playwright test",
		"gen:hue": "openapi-typescript src/lib/server/hue/openhue.yaml --empty-objects-unknown -o src/lib/server/hue/schema.d.ts && prettier --write src/lib/server/hue/schema.d.ts",
		"dev:lan": "vite dev --host",
		"docker:up": "docker compose -f compose.dev.yaml up -d --build",
		"docker:down": "docker compose -f compose.dev.yaml down",
		"docker:logs": "docker compose -f compose.dev.yaml logs -f",
		"check:standalone": "node scripts/check-standalone.js"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/geist": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.63.0",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/chroma-js": "^3.1.3",
		"@types/culori": "^4.0.1",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^5.0.5",
		"bits-ui": "^2.20.2",
		"chroma-js": "^3.2.0",
		"cn": "^0.5.0",
		"culori": "^4.0.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"eventsource": "^5.1.3",
		"globals": "^17.6.0",
		"mode-watcher": "^1.1.0",
		"msw": "^3.0.3",
		"openapi-fetch": "^0.17.0",
		"openapi-msw": "^2.1.1",
		"openapi-typescript": "^7.13.0",
		"playwright": "^1.64.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"selfsigned": "^5.5.0",
		"semver": "^7.8.5",
		"shadcn-svelte": "^1.7.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.2.2",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"undici": "^7.30.1",
		"vite": "^8.3.0",
		"vitest": "^5.0.5",
		"vitest-browser-svelte": "^3.1.0",
		"zod": "^4.6.7"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
